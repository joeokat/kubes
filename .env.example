# Environment identifier (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Supabase Configuration
# The Anon key is public-safe and designed to be exposed in the client
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Sentry Error Monitoring DSN
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0

# Paystack Public Key (never put the secret key in the client!)
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

